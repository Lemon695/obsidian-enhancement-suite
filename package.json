{
	"name": "enhancement-suite",
	"version": "1.1.0",
	"description": "A modular suite of enhancements for Obsidian: tables, YAML, export, replace, JSON, stats, callouts, footnotes, and reading progress.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:compat": "eslint src --rule 'obsidianmd/no-unsupported-api:error'",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@eslint/json": "^2.0.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.3.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
